# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# --- Node & Next.js (removed) ---
node_modules/
.next/
public/
src/
package.json
package-lock.json
yarn.lock
pnpm-lock.yaml
next.config.ts
next-env.d.ts
tsconfig.json
postcss.config.mjs
tailwind.config.mjs
eslint.config.mjs

# --- Dash / misc caches ---
__pycache__/
.ipynb_checkpoints/

# --- Large artifacts / logs (keep models & reports small) ---
catboost_info/
web_backup_*/
*.log

# --- Data: keep only the cleaned CSV you serve ---
data/**
!data/clean_used_cars.csv

# node / next leftovers
node_modules/
.next/
frontend/.vercel/
web_backup_*/

# big local stuff
*.sqlite
*.feather
*.parquet
*.zip
*.7z
*.tar.gz
data/*.json
reports/
catboost_info/
