# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
.venv/
.env

# Streamlit cache
.streamlit/
**/.streamlit/

# Data (keep raw scripts, ignore big files)
data/**/*.parquet
data/**/*.csv
!data/ingestion/**        # keep ingestion scripts
!data/raw/.keep           # allow empty raw dir marker

# Model artifacts (recommend NOT committing; use LFS if needed)
model/*.pkl
model/*.bin
model/preview_gbm.csv
model/metrics_gbm.json
model/schema_best.json
model/cat_levels.json

# OS/editor
.DS_Store
.vscode/
.idea/
